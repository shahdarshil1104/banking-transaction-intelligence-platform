🔹 4️⃣ Create Custom Airflow Image (Dockerfile)
cat > Dockerfile <<'EOF'
FROM apache/airflow:2.9.1-python3.12

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jre-headless \
    curl \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-arm64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

USER airflow
RUN pip install --no-cache-dir pyspark==3.5.1 apache-airflow-providers-apache-spark
EOF
👉 Fixes:
❌ PySpark missing
❌ Java missing
❌ Airflow Spark operator missing
